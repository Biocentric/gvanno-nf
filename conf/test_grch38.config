/*
 * Lightweight GRCh38 CI profile.
 * Uses the committed 11-variant GRCh38 fixture (assets/example.grch38.vcf) whose
 * coordinates were verified against the Ensembl GRCh38 REST API.
 * Expects a GRCh38 gvanno bundle pre-staged under params.refdata_dir.
 */

params {
    config_profile_name        = 'GRCh38 test profile'
    config_profile_description = 'Minimal GRCh38 end-to-end test on the 11-variant fixture'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    input           = "${projectDir}/assets/test_grch38_samplesheet.csv"
    genome          = 'GRCh38'
    refdata_dir     = params.refdata_dir ?: '/tmp/gvanno-nf-test-refs-grch38'
    refdata_mode    = 'prestaged'

    vep_n_forks     = 2
    vep_buffer_size = 100
    scatter_by      = 'none'
}
